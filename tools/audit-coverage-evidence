#!/usr/bin/env python3
"""Require field-appropriate evidence beyond whole-field breadth checklists."""

from __future__ import annotations

from pathlib import Path
from collections import Counter
import argparse
import json
import sys

from lib.atlas_query import DEFAULT_RELEASE


# MSC2020 is authoritative for whole-field literature breadth, but its top-level
# classification alone cannot substantiate an individual educational territory.
BREADTH_ONLY_SOURCE_IDS = {"ola:s:9694700b-a8aa-43a8-ae5b-eff223f0097a"}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--release", type=Path, default=DEFAULT_RELEASE)
    args = parser.parse_args()
    try:
        document = json.loads(args.release.read_text(encoding="utf-8"))
        territories = {
            node["id"]: node for node in document["nodes"]
            if node.get("subtype") == "atlas-territory"
            and node.get("status") != "deprecated"
        }
        qualifying: dict[str, list[dict]] = {identity: [] for identity in territories}
        for source in document["sources"]:
            is_qualified = (
                source["id"] not in BREADTH_ONLY_SOURCE_IDS
                and source["source_type"] != "contributor-analysis"
                and bool(source.get("url"))
                and bool(source.get("coverage_scope"))
                and bool(source.get("coverage_gaps"))
            )
            if not is_qualified:
                continue
            for identity in source.get("coverage_for", []):
                if identity in qualifying:
                    qualifying[identity].append(source)
        missing = [territories[identity] for identity, sources in qualifying.items() if not sources]
        if missing:
            for territory in sorted(missing, key=lambda node: node["label"]):
                print(
                    f"ERROR {territory['id']} {territory['label']}: "
                    "no field-appropriate coverage evidence beyond broad checklists",
                    file=sys.stderr,
                )
            return 1
        types = Counter(
            source["source_type"]
            for sources in qualifying.values()
            for source in sources
        )
        print(
            f"OK coverage evidence: {len(territories)}/{len(territories)} active territories have "
            f"field-appropriate coverage sources; qualifying references by type {dict(sorted(types.items()))}"
        )
        return 0
    except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
        print(f"ERROR {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
