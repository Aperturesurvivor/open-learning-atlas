#!/usr/bin/env python3
"""Create a deterministic tar.gz archive from a pinned release package."""

from __future__ import annotations

from hashlib import sha256
from pathlib import Path
import argparse
import gzip
import io
import tarfile


ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", help="Mathematics release version, for example 0.1.0-alpha")
    args = parser.parse_args()
    package = ROOT / "releases" / "mathematics" / args.version
    if not package.is_dir():
        parser.error(f"release package does not exist: {package}")
    output_dir = ROOT / "dist" / "releases"
    output_dir.mkdir(parents=True, exist_ok=True)
    name = f"open-learning-atlas-mathematics-{args.version}"
    output = output_dir / f"{name}.tar.gz"
    buffer = io.BytesIO()
    with gzip.GzipFile(filename="", mode="wb", fileobj=buffer, mtime=0, compresslevel=9) as compressed:
        with tarfile.open(fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT) as archive:
            for path in sorted(item for item in package.iterdir() if item.is_file()):
                data = path.read_bytes()
                info = tarfile.TarInfo(name=f"{name}/{path.name}")
                info.size = len(data)
                info.mode = 0o644
                info.mtime = 0
                info.uid = 0
                info.gid = 0
                info.uname = ""
                info.gname = ""
                archive.addfile(info, io.BytesIO(data))
    output.write_bytes(buffer.getvalue())
    checksum = sha256(buffer.getvalue()).hexdigest()
    checksum_file = output.with_suffix(output.suffix + ".sha256")
    checksum_file.write_text(f"{checksum}  {output.name}\n", encoding="utf-8")
    print(f"{output}\nSHA-256 {checksum}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
