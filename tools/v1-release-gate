#!/usr/bin/env python3
"""Run the local Mathematics v1.0 release gate, including human review evidence."""

from __future__ import annotations

from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
COMMANDS = [
    (["tools/build-atlas", "--check"], ROOT),
    (["tools/validate-map"], ROOT),
    (["tools/audit-v1", "--require-complete"], ROOT),
    (["tools/audit-quality"], ROOT),
    (["tools/audit-coverage-evidence"], ROOT),
    (["tools/build-release", "--check"], ROOT),
    (["tools/test-release-archive"], ROOT),
    (["tools/build-latest-pointer", "--check"], ROOT),
    (["tools/validate-history"], ROOT),
    (["tools/run-conformance"], ROOT),
    (["tools/validate-migrations"], ROOT),
    (["tools/validate-crosswalks"], ROOT),
    (["tools/build-review-inventory", "--check"], ROOT),
    (["tools/build-review-queue", "--check"], ROOT),
    (["tools/validate-reviews", "--require-complete"], ROOT),
    (["tools/check-links"], ROOT),
    (["deno", "task", "test"], ROOT / "viewer"),
    (["deno", "task", "build"], ROOT / "viewer"),
]


def main() -> int:
    for command, working_directory in COMMANDS:
        print(f"\n==> {' '.join(command)}", flush=True)
        result = subprocess.run(command, cwd=working_directory, check=False)
        if result.returncode:
            print(f"\nV1 GATE FAILED at: {' '.join(command)}", file=sys.stderr)
            return result.returncode
    print("\nV1 GATE PASSED")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
